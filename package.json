{
  "name": "pi-dteam",
  "version": "0.8.6",
  "description": "dteam - model-tier routing execution layer and evidence-driven main-agent protocol for Pi; fresh T1/T2/T3 workers, structured verification, and bounded fan-out",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "dteam",
    "workflow",
    "multi-agent",
    "extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssdiwu/pi-dteam.git"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "README-zh.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "name": "dteam",
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run typecheck:test",
    "test": "vitest run --exclude 'archive/**'",
    "test:watch": "vitest --exclude 'archive/**'"
  }
}
