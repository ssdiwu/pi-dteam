{
  "name": "pi-dteam",
  "version": "0.3.1",
  "description": "dteam - 轻量级多代理编排系统",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "dteam",
    "workflow",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssdiwu/pi-dteam"
  },
  "files": [
    "extensions/**/*",
    "src/**/*.ts",
    "agents/**/*",
    "prompts/**/*",
    "reference/**/*",
    "README.md",
    "README-zh.md"
  ],
  "pi": {
    "name": "dteam",
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "vitest run --exclude 'archive/**'",
    "test:watch": "vitest --exclude 'archive/**'"
  }
}
